# ==============================================================================
# ONCOLINK Environment Configuration (Placeholders only - NEVER commit secrets)
# ==============================================================================

# Project & Environment
PROJECT_NAME=OncoLink
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB (Single-node replica set with authentication)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=oncolink_root_dev_password_change_me
MONGO_APP_USER=oncolink_app
MONGO_APP_PASSWORD=oncolink_app_dev_password_change_me
MONGO_DB_NAME=oncolink
MONGO_PORT=27017

# MongoDB Connection Strings
# Used within Docker container network:
MONGO_URI=mongodb://oncolink_app:oncolink_app_dev_password_change_me@mongodb:27017/oncolink?replicaSet=rs0&authSource=oncolink
MONGO_TEST_URI=mongodb://oncolink_app:oncolink_app_dev_password_change_me@mongodb:27017/oncolink_test?replicaSet=rs0&authSource=oncolink

# MinIO Object Storage (Image Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_dev_password_change_me
MINIO_ENDPOINT=minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=oncolink-cases
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_dev_password_change_me

# Authentication & Security (Tokens)
JWT_SECRET=change_this_to_a_secure_random_hex_key_before_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Versioning
MODEL_VERSION=1.0.0-locked
