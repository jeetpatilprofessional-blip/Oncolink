# ==============================================================================
# ONCOLINK Environment Configuration (Placeholders only - NEVER commit secrets)
# ==============================================================================

# Project & Environment
PROJECT_NAME=OncoLink
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API (Bound to 127.0.0.1 for local isolation)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB (Single-node replica set with authentication)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=replace_with_secure_root_password
MONGO_APP_USER=oncolink_app
MONGO_APP_PASSWORD=replace_with_secure_app_password
MONGO_DB_NAME=oncolink
MONGO_PORT=27017

# MongoDB Connection Strings
# Used within Docker container network:
MONGO_URI=mongodb://oncolink_app:replace_with_secure_app_password@mongodb:27017/oncolink?replicaSet=rs0&authSource=oncolink
MONGO_TEST_URI=mongodb://oncolink_app:replace_with_secure_app_password@mongodb:27017/oncolink_test?replicaSet=rs0&authSource=oncolink

# GridFS Storage (in-database image storage behind StorageService interface)
GRIDFS_BUCKET_NAME=case_images

# Authentication & Security (Tokens)
JWT_SECRET=replace_with_random_64_char_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Versioning
MODEL_VERSION=1.0.0-locked
