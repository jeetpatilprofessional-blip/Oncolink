# ==============================================================================
# ONCOLINK Environment Configuration (Placeholders only - NEVER commit secrets)
# ==============================================================================

# Project & Environment
PROJECT_NAME=OncoLink
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API (Bound to 127.0.0.1 for local isolation)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB (Single-node replica set with authentication)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=replace_with_secure_root_password
MONGO_APP_USER=oncolink_app
MONGO_APP_PASSWORD=replace_with_secure_app_password
MONGO_DB_NAME=oncolink
MONGO_PORT=27017

# MongoDB Connection Strings
# Used within Docker container network:
MONGO_URI=mongodb://oncolink_app:replace_with_secure_app_password@mongodb:27017/oncolink?replicaSet=rs0&authSource=oncolink
MONGO_TEST_URI=mongodb://oncolink_app:replace_with_secure_app_password@mongodb:27017/oncolink_test?replicaSet=rs0&authSource=oncolink

# GridFS Storage (in-database image storage behind StorageService interface)
GRIDFS_BUCKET_NAME=case_images

# Authentication & Security (Tokens)
# Generate JWT_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_random_64_char_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# TOTP Secret Encryption at Rest (Fernet key, 32 url-safe base64-encoded bytes)
# Generate TOTP_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=replace_with_32_byte_base64_fernet_key

# Demo Users Seeding Configuration (python -m app.cli seed-demo-users)
# Each password must be >= 10 characters and distinct from its email.
DEMO_PATIENT_EMAIL=demo.patient@oncolink.local
DEMO_PATIENT_PASSWORD=replace_with_strong_password_patient
DEMO_SCREENER_EMAIL=demo.screener@oncolink.local
DEMO_SCREENER_PASSWORD=replace_with_strong_password_screener
DEMO_DOCTOR_EMAIL=demo.doctor@oncolink.local
DEMO_DOCTOR_PASSWORD=replace_with_strong_password_doctor
DEMO_HOSPITAL_COORDINATOR_EMAIL=demo.coordinator@oncolink.local
DEMO_HOSPITAL_COORDINATOR_PASSWORD=replace_with_strong_password_coordinator
DEMO_ADMIN_EMAIL=demo.admin@oncolink.local
DEMO_ADMIN_PASSWORD=replace_with_strong_password_admin

# Model Versioning
MODEL_VERSION=1.0.0-locked
